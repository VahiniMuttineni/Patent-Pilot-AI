# ==============================================================================
# PatentPilot AI - Backend Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Settings
# ------------------------------------------------------------------------------
# ENVIRONMENT determines the runtime behavior (development, testing, production).
# In production, missing secrets or insecure configurations will prevent startup.
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# Security
# ------------------------------------------------------------------------------
# A secure randomly generated key for signing JWT tokens. Must be set in production.
# Generate a new one using: openssl rand -hex 32
SECRET_KEY=YOUR_SUPER_SECRET_KEY_HERE
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# CORS_ORIGINS restricts which frontend domains can access this API.
# Development: "*"
# Production: "https://your-frontend-app.vercel.app,https://www.yourdomain.com"
CORS_ORIGINS=*

# ------------------------------------------------------------------------------
# Database & Redis
# ------------------------------------------------------------------------------
# The primary PostgreSQL connection string. 
# Render provides this in the format: postgres://user:pass@host/db
# The backend will automatically convert it to asyncpg in production.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/patentpilot

# Connection Pooling settings (optimized for Render free/starter tiers)
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800

# Redis connection string for caching responses and rate limiting.
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# AI / LLM Providers
# ------------------------------------------------------------------------------
# LLM_PROVIDER can be 'gemini', 'groq', or 'ollama'
LLM_PROVIDER=groq

# Groq Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Ollama Configuration (Local inference only)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ------------------------------------------------------------------------------
# Authentication
# ------------------------------------------------------------------------------
# Google OAuth Client ID for authenticating users
GOOGLE_CLIENT_ID=your_google_client_id_here

# ------------------------------------------------------------------------------
# External Patent & Chemical Providers
# ------------------------------------------------------------------------------
LENS_API_TOKEN=your_lens_api_token_here
NCBI_API_KEY=optional_ncbi_api_key_here
CHEMSPIDER_API_KEY=optional_chemspider_api_key_here
EPO_CLIENT_ID=optional_epo_client_id_here
EPO_CLIENT_SECRET=optional_epo_client_secret_here
