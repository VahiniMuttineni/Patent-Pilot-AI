{
  "name": "patentpilot-root",
  "version": "1.0.0",
  "description": "Root runner scripts for PatentPilot",
  "scripts": {
    "frontend": "npm run dev --prefix frontend",
    "backend": "cd backend && ./venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload",
    "start": "npx -y concurrently \"npm run frontend\" \"npm run backend\""
  }
}
